generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  createdAt DateTime  @default(now())
  vehicles  Vehicle[]
}

model Vehicle {
  id          String      @id @default(cuid())
  userId      String
  make        String
  model       String
  year        Int
  plateNumber String
  color       String
  vin         String?
  fuelType    String      @default("ICE")
  notes       String?
  imagePath   String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pmsRecords  PMSRecord[]

  @@index([userId])
}

model PMSRecord {
  id               String   @id @default(cuid())
  vehicleId        String
  shopName         String?
  serviceDate      DateTime
  mileage          Int?
  totalAmount      Float
  items            String
  receiptImagePath String?
  createdAt        DateTime @default(now())
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}
